# Machine-specific settings (name, email) live in ~/.gitconfig.local — not tracked.
[include]
    path = ~/.gitconfig.local

#
# Core Settings
#

[core]
    editor = nvim
    autocrlf = input
    fileMode = false
    attributesFile = ~/.git-attributes

[init]
    defaultBranch = main

[url "https://github.com/"]
    insteadOf = git://github.com/


#
# Credentials & Security
#

#
# Diff & Merge Tools
#

[diff]
    tool = difftastic

[diff "difftastic"]
    command = difft

[diff "jupyternotebook"]
    command = git-nbdiffdriver diff

[difftool]
    prompt = false

[difftool "difftastic"]
    # Fallback for `git difftool -t difftastic`.
    cmd = difft "$MERGED" "$LOCAL" "abcdef1" "100644" "$REMOTE" "abcdef2" "100644"

[difftool "nbdime"]
    cmd = git-nbdifftool diff \"$LOCAL\" \"$REMOTE\" \"$BASE\"

[merge "jupyternotebook"]
    driver = git-nbmergedriver merge %O %A %B %L %P
    name = jupyter notebook merge driver

[mergetool]
    prompt = false

[mergetool "nbdime"]
    cmd = git-nbmergetool merge \"$BASE\" \"$LOCAL\" \"$REMOTE\" \"$MERGED\"

[pager]
    difftool = true

#
# Aliases
#

[alias]
    # Run `git log -p` with difftastic diffs.
    dlog  = -c diff.difftastic.command=difft log -p --ext-diff
    # Show most recent commit with difftastic.
    dshow = -c diff.difftastic.command=difft show --ext-diff
    # Run `git diff` with difftastic.
    difft = -c diff.difftastic.command=difft diff

#
# Maintenance
#
