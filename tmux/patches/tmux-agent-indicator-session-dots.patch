+# One format read supplies raw values; show-options distinguishes unset from
+# explicitly empty options (which must not fall back to the defaults).
+option_names=(active inactive attention color active-color attention-color reset-style separator idle attention-states running done running-color done-color)
+declare -A option_set
+while IFS= read -r line; do
+    case "$line" in
+        @agent-indicator-session-dots-*)
+            option="${line%% *}"
+            option_set["${option#@agent-indicator-session-dots-}"]=1
+            ;;
+    esac
+done < <(tmux show-options -g 2>/dev/null)
+# shortcut: options cannot contain newlines; use encoded values if needed.
+format=""
+for option in "${option_names[@]}"; do
+    format+="#{@agent-indicator-session-dots-${option}}"$'\n'
+done
+mapfile -t option_values < <(tmux display-message -p "$format")
+declare -A dot_options
+for i in "${!option_names[@]}"; do
+    option="${option_names[$i]}"
+    if [[ -v option_set["$option"] ]]; then
+        dot_options["$option"]="${option_values[$i]}"
